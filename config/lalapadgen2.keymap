#include <input/processors.dtsi>
#include <dt-bindings/zmk/zip_dynamic_scale.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

#define DEFAULT_LAYER 0
#define SECONDARY_LAYER 1
#define TERTIARY_LAYER 2
#define SYSTEM_LAYER 3

&mt { quick-tap-ms = <200>; };

&lt { quick-tap-ms = <200>; };

/ {
     behaviors {
        zip_dyn_scale: zip_dyn_scale {
            compatible = "zmk,behavior-zip-dynamic-scale";
            #binding-cells = <2>;
        };

        zip_dyn_scale_set: zip_dyn_scale_set {
            compatible = "zmk,behavior-zip-dynamic-scale-set";
            #binding-cells = <2>;
        };

        mt2: mod_tap2 {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            quick-tap-ms = <200>;
            require-prior-idle-ms = <125>;
            bindings = <&kp>, <&kp>;
        };

        tap_dance_layer_1and2: tap_dance_layer_1and2 {
            compatible = "zmk,behavior-tap-dance";
            label = "td_mo12";
            #binding-cells = <0>;
            bindings = <&mo 2>, <&mo 3>;
        };
    };

    combos {
        compatible = "zmk,combos";

        CONBO_ESC {
            bindings = <&kp ESCAPE>;
            key-positions = <0 1>;
        };

        COMBO_TAB {
            bindings = <&kp TAB>;
            key-positions = <10 11>;
        };

        left_p {
            bindings = <&kp LEFT_PARENTHESIS>;
            key-positions = <12 13>;
        };

        right_p {
            bindings = <&kp RIGHT_PARENTHESIS>;
            key-positions = <13 14>;
        };

        l_d {
            bindings = <&kp LA(LC(D))>;
            key-positions = <20 21>;
        };

        c_d {
            bindings = <&kp LA(LC(F))>;
            key-positions = <21 22>;
        };

        r_d {
            bindings = <&kp LA(LC(G))>;
            key-positions = <22 23>;
        };

        f_d {
            bindings = <&kp LA(LC(ENTER))>;
            key-positions = <30 31>;
        };

        cap_1 {
            bindings = <&kp LS(LG(NUMBER_4))>;
            key-positions = <40 41>;
        };

        cap_f {
            bindings = <&kp LS(LG(NUMBER_3))>;
            key-positions = <39 40>;
        };

        system {
            bindings = <&tog 4>;
            key-positions = <41 40 39>;
        };

        re_system {
            bindings = <&tog 0>;
            key-positions = <30 31 32>;
        };
    };

    macros {
        mission: mission {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LC(UP)>;
            label = "MISSION";
        };

        launch: launch {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp RG(L)>;
            label = "LAUNCH";
        };

        tab_next: tab_next {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LC(TAB)>;
            label = "TAB_NEXT";
        };

        tab_prev: tab_prev {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(LC(TAB))>;
            label = "TAB_PREV";
        };

        win_layer: win_ly {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 1>, <&macro_wait_time 200>, <&to 1>;

            label = "WIN_LY";
        };

        mac_layer: mac_layer {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 0>, <&macro_wait_time 200>, <&to 0>;

            label = "MAC_LAYER";
        };
lt_to_layer_0: lt_to_layer_0 {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_TO_0";
            bindings = <&mo>, <&to_layer_0>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };

        scroll_up_down: behavior_sensor_rotate_mouse_wheel_up_down {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_UP>, <&msc SCRL_DOWN>;

            tap-ms = <20>;
        };

        tog_on: toggle_layer_on_only {
            compatible = "zmk,behavior-toggle-layer";
            #binding-cells = <1>;
            display-name = "Toggle Layer On";
            toggle-mode = "on";
        };

        tog_off: toggle_layer_off_only {
            compatible = "zmk,behavior-toggle-layer";
            #binding-cells = <1>;
            display-name = "Toggle Layer Off";
            toggle-mode = "off";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        MAC_LAYER {
            display-name = "Default";
            bindings = <
&kp Q              &kp W       &kp E             &kp R        &kp T                                               &kp Y         &kp U        &kp I             &kp O       &kp P
&kp A              &kp S       &kp D             &kp F        &kp G                                               &kp H         &kp J        &kp K             &kp L       &kp MINUS
&mt2 LEFT_SHIFT Z  &kp X       &kp C             &kp V        &kp B                                               &kp N         &kp M        &kp COMMA         &kp PERIOD  &mt RIGHT_SHIFT SLASH
&kp LCTRL          &kp LALT    &kp RS(LEFT_GUI)  &lt 3 SPACE  &lt 3 SPACE  &kp BACKSPACE  &mt RIGHT_COMMAND CAPS  &lt 2 ENTER   &lt 2 ENTER  &kp SINGLE_QUOTE  &kp SEMI    &kp EQUAL
                   &mac_layer  &kp RIGHT         &kp DOWN     &kp LEFT     &kp UP         &kp RG(F2)              &kp RG(LEFT)  &kp LG(F1)   &kp RG(RIGHT)     &win_layer
&mkp LCLK          &mkp RCLK   &launch                                                                                                       &mkp LCLK         &mkp RCLK   &launch
&mkp MB4           &mkp MB5    &tab_prev         &tab_next    &mkp MB5                                            &mkp MB4      &mkp MB5     &mission          &mission    &mkp MB5
            >;
        };

        WIN_LAYER {
            display-name = "Win";
            bindings = <
&kp Q              &kp W      &kp E           &kp R        &kp T                                        &kp Y         &kp U        &kp I             &kp O       &kp P
&kp A              &kp S      &kp D           &kp F        &kp G                                        &kp H         &kp J        &kp K             &kp L       &kp MINUS
&mt2 LEFT_SHIFT Z  &kp X      &kp C           &kp V        &kp B                                        &kp N         &kp M        &kp COMMA         &kp PERIOD  &mt RIGHT_SHIFT SLASH
&kp LEFT_WIN       &kp LALT   &kp LANGUAGE_2  &lt 3 SPACE  &lt 3 SPACE  &kp BACKSPACE  &mt RCTRL LANG1  &lt 2 ENTER   &lt 2 ENTER  &kp SINGLE_QUOTE  &kp SEMI    &kp EQUAL
                   &none      &kp RIGHT       &kp DOWN     &kp LEFT     &kp UP         &kp RG(F2)       &kp RG(LEFT)  &kp LG(F1)   &kp RG(RIGHT)     &none
&mkp LCLK          &mkp RCLK  &mkp MCLK                                                                                            &mkp LCLK         &mkp RCLK   &mkp MCLK
&mkp MB4           &mkp MB5   &kp RG(TAB)     &kp RG(D)    &kp LCTRL                                    &mkp MB4      &mkp MB5     &kp RG(TAB)       &kp RG(D)   &kp LCTRL
            >;
        };

        SECONDARY_LAYER {
            display-name = "secondary_layer";
            bindings = <
&kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3      &kp NUMBER_4       &kp N5                   &kp NUMBER_6     &kp NUMBER_7   &kp NUMBER_8      &kp NUMBER_9       &kp NUMBER_0
&kp F1        &kp F2        &kp F3            &kp F4             &kp F5                   &kp EXCLAMATION  &kp AT_SIGN    &kp HASH          &kp DOLLAR         &kp PERCENT
&kp F6        &kp F7        &kp F8            &kp F9             &kp F10                  &kp CARET        &kp AMPERSAND  &kp ASTRK         &kp TILDE          &kp PIPE
&trans        &trans        &trans            &trans             &trans   &trans  &trans  &trans           &trans         &kp KP_NUMBER_0   &kp LEFT_BRACKET   &kp RIGHT_BRACKET
              &trans        &trans            &trans             &trans   &trans  &trans  &trans           &trans         &trans            &trans
&trans        &trans        &trans                                                                                        &trans            &trans             &trans
&trans        &trans        &kp LC(LG(LEFT))  &kp LC(LG(RIGHT))  &trans                   &trans           &trans         &kp LC(LG(LEFT))  &kp LC(LG(RIGHT))  &trans
            >;
        };

        TERTIARY_LAYER {
            display-name = "tertiary_layer";
            bindings = <
&kp PAGE_UP    &kp HOME  &kp UP_ARROW  &kp END    &trans                  &kp PAGE_UP    &kp HOME  &kp UP_ARROW    &kp END    &kp PRINTSCREEN
&kp PAGE_DOWN  &kp LEFT  &kp DOWN      &kp RIGHT  &trans                  &kp PAGE_DOWN  &kp LEFT  &kp DOWN_ARROW  &kp RIGHT  &kp SCROLLLOCK
&trans         &trans    &trans        &trans     &trans                  &trans         &mkp MB4  &trans          &mkp MB5   &kp PAUSE_BREAK
&trans         &trans    &trans        &trans     &trans  &trans  &trans  &trans         &trans    &trans          &trans     &trans
               &trans    &trans        &trans     &trans  &trans  &trans  &trans         &trans    &trans          &trans
&trans         &trans    &trans                                                                    &trans          &trans     &trans
&trans         &trans    &trans        &trans     &trans                  &trans         &trans    &trans          &trans     &trans
            >;
        };

        SYSTEM_LAYER {
            display-name = "system_layer";
            bindings = <
&kp F1   &kp F2   &kp F3   &kp F4   &kp F5                   &out OUT_TOG                   &bt BT_SEL 0                   &bt BT_SEL 1                   &bt BT_SEL 2                   &bt BT_SEL 3
&kp F6   &kp F7   &kp F8   &kp F9   &kp F10                  &sys_reset                     &bootloader                    &bt BT_CLR                     &bt BT_CLR_ALL                 &trans
&kp F11  &kp F12  &kp F13  &kp F14  &kp F15                  &zip_dyn_scale ZDS_XY ZDS_INC  &zip_dyn_scale ZDS_XY ZDS_DEC  &zip_dyn_scale ZDS_SC ZDS_INC  &zip_dyn_scale ZDS_SC ZDS_DEC  &zip_dyn_scale ZDS_ALL ZDS_RST
&trans   &trans   &trans   &trans   &trans   &trans  &trans  &trans                         &trans                         &trans                         &trans                         &trans
         &trans   &trans   &trans   &trans   &trans  &trans  &trans                         &trans                         &trans                         &trans
&trans   &trans   &trans                                                                                                   &trans                         &trans                         &trans
&trans   &trans   &trans   &trans   &trans                   &trans                         &trans                         &trans                         &trans                         &trans
            >;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        Cond_Syslayer {
            if-layers = <2 3>;
            then-layer = <4>;
        };
    };
};
